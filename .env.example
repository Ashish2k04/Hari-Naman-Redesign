# Copy this file to server/.env and fill in your keys
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=YOUR_MONGODB_URI

# JWT Secret for Session Hashing
JWT_SECRET=YOUR_JWT_SECRET

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# ImageKit Configuration (Optional - Fallback saves files to disk)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Default Admin User Credentials (for seed script)
ADMIN_DEFAULT_NAME=Hari Naman Greens Admin
ADMIN_DEFAULT_EMAIL=admin@hn-greens.com
ADMIN_DEFAULT_PASSWORD=password123
